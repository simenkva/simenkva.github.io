
@misc{kvaalNoNeedGrid2022a,
	title = {No need for a grid: {Adaptive} fully-flexible gaussians for the time-dependent {Schr}{\textbackslash}"odinger equation},
	shorttitle = {No need for a grid},
	url = {http://arxiv.org/abs/2207.00271},
	abstract = {Linear combinations of complex gaussian functions, where the nonlinear parameters are allowed to vary, are shown to be an extremely flexible representation for the solution of the time-dependent Schr{\textbackslash}"odinger equation in one spatial dimension. Propagation of such wavefunctions using the Dirac--Frenkel variational principle is notoriously hard, and we present instead a scheme based on the method of vertical lines, or Rothe's method. We apply the method to a simple test system mimicking an atom subject to an extreme laser pulse, producing complicated ionization dynamics. The scheme is shown to perform very well on this model. Since the propagation method can be formulated entirely in terms of gaussian integrals and expectation values, we eliminate the need for large grids using only a handful of gaussian functions but with the same accuracy. This paves the way for accurate and affordable solutions of the time-dependent Schr{\textbackslash}"odinger equation for multi-atom molecules beyond the Born--Oppenheimer approximation.},
	language = {en},
	urldate = {2022-11-03},
	publisher = {arXiv},
	author = {Kvaal, Simen and Lasser, Caroline and Pedersen, Thomas Bondo and Adamowicz, Ludwik},
	month = jul,
	year = {2022},
	note = {arXiv:2207.00271 [physics, physics:quant-ph]},
	keywords = {Physics - Chemical Physics, Quantum Physics},
	annote = {Comment: 6 pages, 5 figures},
	file = {Kvaal et al. - 2022 - No need for a grid Adaptive fully-flexible gaussi.pdf:/Users/simenkva/Zotero/storage/3IXB9BNJ/Kvaal et al. - 2022 - No need for a grid Adaptive fully-flexible gaussi.pdf:application/pdf},
}

@misc{fredheimReducedDensityMatrix2026,
	title = {Reduced {Density} {Matrix} {Functional} {Theory} {And} {A} {Reduced} {Formulation} {Of} {Density} {Functional} {Theory}},
	url = {http://arxiv.org/abs/2510.12242},
	doi = {10.48550/arXiv.2510.12242},
	abstract = {A mathematical framework for reduced density matrix functional theory (RDMFT) is proposed. The work is inspired by and generalizes the work by E.H.{\textasciitilde}Lieb [E.H. Lieb, Int. J. Quant. Chem. 24(1983), pp.243--277] on density-functional theory (DFT). We introduce a Banach space for density matrices with finite kinetic energy. The dual space is a rich class of single-particle potentials, i.e., Hermitian forms. The ground state energy of an \$N\$-fermion system with external forces given by any such Hermitian form is expressed as the Legendre--Fenchel transform of a convex and lower semicontinuous ``universal'' reduced density matrix functional. The formalism is employed to provide a mathematical framework for density-functional theory (DFT). The main tool here is a rigorous definition of diagonals of reduced density matrices. The result is a refinement of Lieb's results on DFT applicable to a wide variety of models.},
	urldate = {2026-01-15},
	publisher = {arXiv},
	author = {Fredheim, Håkon R. and Kvaal, Simen},
	month = jan,
	year = {2026},
	note = {arXiv:2510.12242 [math-ph]},
	keywords = {Physics - Chemical Physics, Mathematical Physics},
	file = {Preprint PDF:/Users/simenkva/Zotero/storage/8FAYVINM/Fredheim and Kvaal - 2026 - Reduced Density Matrix Functional Theory And A Reduced Formulation Of Density Functional Theory.pdf:application/pdf;Snapshot:/Users/simenkva/Zotero/storage/P97GVV8V/2510.html:text/html},
}

@misc{schraderRothesMethodQuantum2026,
	title = {Rothe's {Method} for {Quantum} {Dynamics} in {Atoms} and {Molecules} with {Gaussian} {Wavepackets}},
	url = {https://arxiv.org/abs/2606.20947v1},
	doi = {10.48550/arXiv.2606.20947},
	abstract = {Capable of capturing both bound and continuum quantum dynamics, Gaussian wavepackets are highly attractive basis functions for simulating laser-driven processes in atoms and molecules. Unfortunately, fully flexible Gaussian wavepackets are exceedingly challenging to propagate in a numerically stable manner within the framework of conventional time-dependent variational principles. In this chapter, we discuss the sources of the numerical issues and review an alternative approach, Rothe's method, that offers a route to improved numerical stability. Recent proof-of-concept simulations based on Rothe's method indicate that Gaussian wavepackets provide results on par with highly accurate grid-based methods for both electronic and rovibrational quantum dynamics, including ultrafast nonlinear processes that involve the continuum such as high-harmonic generation. Remarkably few Gaussian wavepackets are needed to achieve the high accuracy of grid-based approaches, indicating that further algorithmic developments and efficient implementations may enable efficient simulations of not only electronic and rovibrational phenomena but also fully coupled electronic-nuclear quantum dynamics with significantly reduced memory demands. We also point out remaining practical challenges, including matrix elements of the squared Hamiltonian and the treatment of Coulomb cusps.},
	language = {en},
	urldate = {2026-09-15},
	publisher = {arXiv},
	author = {Schrader, Simon Elias and Kristiansen, Håkon Emil and Wozniak, Aleksander P. and Adamowicz, Ludwik and Kvaal, Simen and Pedersen, Thomas Bondo},
	month = jun,
	year = {2026},
	file = {Full Text PDF:/Users/simenkva/Zotero/storage/LUXZWKCF/Schrader et al. - 2026 - Rothe's Method for Quantum Dynamics in Atoms and Molecules with Gaussian Wavepackets.pdf:application/pdf},
}
